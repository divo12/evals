FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY tracker.mjs /opt/tracker.mjs
RUN mkdir -p /hidden

ENV LEDGER_PATH=/hidden/ledger.jsonl
ENV BIND=0.0.0.0
ENV TRACKER_PORT=9410

EXPOSE 9410
CMD ["node", "/opt/tracker.mjs"]
