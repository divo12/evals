FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY generate.mjs /opt/generate.mjs
COPY tracker.mjs /opt/tracker.mjs
COPY tracker-entrypoint.sh /tracker-entrypoint.sh
RUN chmod +x /tracker-entrypoint.sh && mkdir -p /hidden

ENV LEDGER_PATH=/hidden/ledger.jsonl
ENV BIND=0.0.0.0
ENV TRACKER_PORT=9410

EXPOSE 9410
ENTRYPOINT ["/tracker-entrypoint.sh"]
