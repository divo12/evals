FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/world
COPY generate.mjs world.mjs protected-check.mjs entrypoint.sh /opt/world/
RUN chmod +x /opt/world/entrypoint.sh && mkdir -p /hidden

ENV WORKSPACE=/app
ENV ORACLE_PATH=/hidden/oracle.json
ENV ORACLE_OUT=/hidden/oracle.json
ENV LEDGER_PATH=/hidden/ledger.jsonl
ENV BIND=0.0.0.0
ENV PORT=4747
ENV PROFILE=smoke

EXPOSE 4747
ENTRYPOINT ["/opt/world/entrypoint.sh"]
