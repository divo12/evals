# https://cloud.trigger.dev → project → API keys
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# Personal access token (tr_pat_...) from https://cloud.trigger.dev/account/tokens
# Required for the treatment sidecar to run `trigger dev`. Not the project secret.
TRIGGER_ACCESS_TOKEN=

# Treatment fan-out children call a model from the sidecar worker
ANTHROPIC_API_KEY=
# Optional. Sidecar copies this into ANTHROPIC_API_KEY when the Console key is unset.
# Claude Code OAuth tokens often cannot call Sonnet outside Claude Code.
CLAUDE_CODE_OAUTH_TOKEN=
